{
  "name": "ciftron-founders-os",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:smoke": "python3 tests/smoke.py",
    "test:ui": "python3 -I tests/smoke.py && python3 -I tests/live_e2e.py",
    "test:all": "npm test && npm run test:ui"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.119.2",
    "mammoth": "1.13.0",
    "unpdf": "2.2.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-pgvector": "0.0.18"
  }
}
