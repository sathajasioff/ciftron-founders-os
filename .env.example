# Copy these into Vercel > Project > Settings > Environment Variables. Never commit real values.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public anon (or publishable) key. Safe in the browser; RLS protects the data.
SUPABASE_ANON_KEY=
# Service role (or secret) key. Server functions only.
SUPABASE_SERVICE_ROLE_KEY=
# 32 random bytes, base64. Generate with: openssl rand -base64 32
ENCRYPTION_KEY=
# The only email allowed to use the OS.
OWNER_EMAIL=
# Optional: Claude model for Brain features.
ANTHROPIC_MODEL=claude-sonnet-5-5
# Optional: OpenAI model for the Strategy Room challenger.
OPENAI_MODEL=gpt-6.1-sol
# Optional: HighLevel API Version header (falls back to 2021-07-28) and Meta Graph API version.
HL_API_VERSION=v3
META_API_VERSION=v26.0
# Optional: Graphics default image model, Jarvis voice.
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2
# Phase 6: routines. A long random string; Vercel cron sends it as a Bearer token.
# Generate with: openssl rand -base64 32
CRON_SECRET=
# Optional: extra browser origins allowed to call /api/mcp (comma separated). CLI clients need nothing.
APP_ORIGIN=
# Phase 8 (optional): a different Apify actor for LinkedIn posts. Input sent: {"profileUrls": [url], "maxItems": 24}.
APIFY_LINKEDIN_ACTOR=
# Phase 9 (optional): the public address of the OS, used for the Google sign-in redirect.
# Leave empty to use the address the request came in on. Example: https://os.ciftron.com
APP_URL=
